# --- App ---
APP_NAME="RAG Chat API"
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT (must match the secret the Next.js frontend signs with) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- LLM / Embeddings (required for document ingest and Q&A) ---
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# --- Tavily (web search + URL ingest) ---
TAVILY_API_KEY=tvly-...

# --- Storage ---
UPLOADS_DIR=./data/uploads

# --- Database (required for app data + pgvector embeddings) ---
# Use a Postgres instance with the pgvector extension (see docker-compose.yml)
DATABASE_URL=postgresql://ragchat:ragchat@localhost:5432/ragchat
